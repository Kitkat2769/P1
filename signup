
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Attendee Management | Conference Organizer</title>

    <!-- Existing project styles -->
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="form.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Load the JavaScript after the HTML is ready -->
    <script src="script.js" defer></script>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <a href="index.html">Overview</a>
        <a href="signup.html" aria-current="page">Attendees</a>
        <a href="events.html">Schedule</a>
        <a href="materials.html">Material Management</a>
    </nav>

    <main class="container py-5">

        <!-- Page heading -->
        <header class="text-center mb-5">
            <h1>Attendee Management</h1>
            <p class="text-muted">
                Register conference attendees and manage their information.
            </p>
        </header>

        <!-- Registration form -->
        <section class="signup-section card shadow-sm mb-5">
            <div class="card-body p-4">

                <h2 id="form-heading" class="h4 mb-4">
                    Register a New Attendee
                </h2>

                <div id="status-message"
                     class="alert d-none"
                     role="status"
                     aria-live="polite"></div>

                <form id="sign-up" novalidate>

                    <input type="hidden" id="attendee-id">

                    <div class="row g-3">

                        <div class="col-md-6 form-item">
                            <label for="full-name" class="form-label">
                                Full Name *
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="full-name"
                                   name="fullName"
                                   placeholder="Enter full name"
                                   autocomplete="name"
                                   required>
                            <div class="invalid-feedback">
                                Please enter a valid full name.
                            </div>
                        </div>

                        <div class="col-md-6 form-item">
                            <label for="email" class="form-label">
                                Email Address *
                            </label>
                            <input type="email"
                                   class="form-control"
                                   id="email"
                                   name="email"
                                   placeholder="name@example.com"
                                   autocomplete="email"
                                   required>
                            <div class="invalid-feedback">
                                Please enter a valid email address.
                            </div>
                        </div>

                        <div class="col-md-6 form-item">
                            <label for="phone" class="form-label">
                                Contact Phone Number
                            </label>
                            <input type="tel"
                                   class="form-control"
                                   id="phone"
                                   name="phone"
                                   placeholder="Optional"
                                   autocomplete="tel">
                            <div class="invalid-feedback">
                                Please enter a valid phone number.
                            </div>
                        </div>

                        <div class="col-md-6 form-item">
                            <label for="age" class="form-label">
                                Age or Year/Grade *
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="age"
                                   name="age"
                                   placeholder="e.g., 20 or Junior"
                                   required>
                            <div class="invalid-feedback">
                                Please enter your age or year/grade.
                            </div>
                        </div>

                        <div class="col-12 form-item">
                            <label for="affiliation" class="form-label">
                                Address or Affiliation *
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="affiliation"
                                   name="affiliation"
                                   placeholder="e.g., Penn State Brandywine"
                                   autocomplete="organization"
                                   required>
                            <div class="invalid-feedback">
                                Please enter an address or affiliation.
                            </div>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit"
                                class="btn btn-primary"
                                id="submit-button">
                            Add Attendee
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary d-none"
                                id="cancel-edit">
                            Cancel Edit
                        </button>

                        <button type="reset"
                                class="btn btn-outline-secondary"
                                id="reset-form">
                            Clear Form
                        </button>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        * Required fields
                    </p>

                </form>
            </div>
        </section>

        <!-- Attendee records -->
        <section aria-labelledby="attendees-heading">

            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-3 mb-3">
                <div>
                    <h2 id="attendees-heading" class="h4 mb-1">
                        Registered Attendees
                    </h2>
                    <p class="text-muted mb-0">
                        Total attendees:
                        <strong id="attendee-count">0</strong>
                    </p>
                </div>

                <button type="button"
                        id="export-json"
                        class="btn btn-outline-primary">
                    Download JSON
                </button>
            </div>

            <div class="table-responsive card shadow-sm">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Age/Year</th>
                            <th scope="col">Address/Affiliation</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="attendee-table-body">
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No attendees registered yet.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </section>

    </main>

    <!-- Footer -->
    <footer class="text-center py-4 mt-5 border-top">
        <p class="mb-0">
            &copy; 2026 Conference Event Organizer
        </p>
    </footer>

</body>
</html>
